<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
	<LangVersion>13.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="8.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
	<!-- gRPC客户端测试依赖；DI 与通用主机由下方的 Microsoft.AspNetCore.App 共享框架提供 -->
	<PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrawlerCore\CrawlerCore.csproj" />
    <ProjectReference Include="..\CrawlerMaster.WPF\CrawlerMaster.WPF.csproj" />
    <ProjectReference Include="..\CrawlerWorker\CrawlerWorker.csproj" />
    <!-- Worker 不再直接引用插件程序集（W-04），测试直接引用：ThesisPlugin 的解析与契约测试、集成测试用的 MockPlugin -->
    <ProjectReference Include="..\ThesisPlugin\ThesisPlugin.csproj" />
    <ProjectReference Include="..\MockPlugin\MockPlugin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- 端到端集成测试（Integration/）：进程内托管 Master 与 Worker，并用 Kestrel 提供静态测试网站 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Integration\TestSite\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 进程内 Worker 的 PluginManager 从 AppContext.BaseDirectory/Plugins 加载插件。这里把 MockPlugin 复制到
       测试输出目录的 Plugins/MockPlugin/，与 CrawlerWorker 的部署方式（每个插件一个子目录）一致 -->
  <Target Name="CopyMockPluginForIntegrationTests" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)MockPlugin.dll" DestinationFolder="$(OutDir)Plugins\MockPlugin" SkipUnchangedFiles="true" />
  </Target>

</Project>