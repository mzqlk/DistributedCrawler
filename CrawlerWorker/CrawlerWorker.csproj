<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<LangVersion>13.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrawlerCore\CrawlerCore.csproj" />
  </ItemGroup>

  <!-- 随 Worker 一起部署的插件。只保证构建顺序（ReferenceOutputAssembly=false），Worker 不直接引用插件程序集；
       构建/发布后由下面的目标把每个插件的输出复制到 Plugins/<插件项目名>/（W-04） -->
  <ItemGroup>
    <CrawlerPlugin Include="..\ThesisPlugin\ThesisPlugin.csproj" />
    <CrawlerPlugin Include="..\MockPlugin\MockPlugin.csproj" />
    <ProjectReference Include="@(CrawlerPlugin)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
	  <!-- gRPC双角色依赖 -->
	  <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
	  <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
	  <PackageReference Include="Google.Protobuf" Version="3.34.1" />
	  <PackageReference Include="Grpc.Tools" Version="2.80.0" PrivateAssets="All" />
	  <!-- 通用主机 -->
	  <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.6" />
	  <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.6" />
	  <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.6" />
	  <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.6" />
	  <!-- 系统资源采集 -->
	  <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.6" />
	  <!-- Serilog日志 -->
	  <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
	  <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
	  <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />

	  <!-- 爬虫引擎核心依赖（HtmlAgilityPack 只有插件使用，由插件自带） -->
	  <PackageReference Include="AngleSharp" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
	<Protobuf Include="Protos\worker_control.proto" GrpcServices="Server" CompileOutputs="true" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 取得各插件的输出目录（与 ProjectReference 相同的方式求值），收集要部署的文件：
       插件程序集、pdb、deps.json 以及插件自己的依赖。CrawlerCore 由 Worker 提供，不随插件部署
       （插件项目对它的引用是 Private=false；这里再排除一次，防止插件输出目录里残留旧版本） -->
  <Target Name="_CollectCrawlerPluginFiles" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="@(CrawlerPlugin)" Targets="GetTargetPath" RemoveProperties="RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_CrawlerPluginAssembly" />
    </MSBuild>
    <ItemGroup>
      <_CrawlerPluginCandidate Include="%(_CrawlerPluginAssembly.RootDir)%(_CrawlerPluginAssembly.Directory)*.dll;%(_CrawlerPluginAssembly.RootDir)%(_CrawlerPluginAssembly.Directory)*.pdb;%(_CrawlerPluginAssembly.RootDir)%(_CrawlerPluginAssembly.Directory)*.deps.json">
        <PluginName>%(_CrawlerPluginAssembly.Filename)</PluginName>
      </_CrawlerPluginCandidate>
      <_CrawlerPluginFile Include="@(_CrawlerPluginCandidate)" Condition="!$([System.String]::Copy('%(Filename)').StartsWith('CrawlerCore'))" />
    </ItemGroup>
  </Target>

  <Target Name="CopyCrawlerPluginsAfterBuild" AfterTargets="Build" DependsOnTargets="_CollectCrawlerPluginFiles">
    <Copy SourceFiles="@(_CrawlerPluginFile)"
          DestinationFiles="@(_CrawlerPluginFile->'$(OutDir)Plugins\%(PluginName)\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="插件已复制到 $(OutDir)Plugins：@(_CrawlerPluginAssembly->'%(Filename)', ', ')" />
  </Target>

  <Target Name="CopyCrawlerPluginsAfterPublish" AfterTargets="Publish" DependsOnTargets="_CollectCrawlerPluginFiles">
    <Copy SourceFiles="@(_CrawlerPluginFile)"
          DestinationFiles="@(_CrawlerPluginFile->'$(PublishDir)Plugins\%(PluginName)\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="插件已复制到 $(PublishDir)Plugins：@(_CrawlerPluginAssembly->'%(Filename)', ', ')" />
  </Target>

</Project>
