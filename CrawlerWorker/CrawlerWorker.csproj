<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<LangVersion>13.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrawlerCore\CrawlerCore.csproj" />
    <ProjectReference Include="..\MockPlugin\MockPlugin.csproj" />
    <ProjectReference Include="..\ThesisPlugin\ThesisPlugin.csproj" />
  </ItemGroup>

  <ItemGroup>
	  <!-- gRPC双角色依赖 -->
	  <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
	  <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
	  <PackageReference Include="Google.Protobuf" Version="3.34.1" />
	  <PackageReference Include="Grpc.Tools" Version="2.80.0" PrivateAssets="All" />
	  <!-- 通用主机 -->
	  <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.6" />
	  <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.6" />
	  <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.6" />
	  <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.6" />
	  <!-- 系统资源采集 -->
	  <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.6" />
	  <!-- Serilog日志 -->
	  <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
	  <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
	  <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />

	  <!-- 爬虫引擎核心依赖 -->
	  <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
	  <PackageReference Include="AngleSharp" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
	<Protobuf Include="Protos\worker_control.proto" GrpcServices="Server" CompileOutputs="true" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

	<Target Name="CopyPluginDllsToOutput" AfterTargets="Build;Publish">
		<!-- 1. 确定基础路径（修复斜杠拼接错误） -->
		<PropertyGroup>
			<!-- 强制使用 MSBuildProjectDirectory 作为基准，防止相对路径漂移 -->
			<SolutionDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))</SolutionDir>
			<!-- 【核心修改1】适配你的实际结构：MockPlugin直接在解决方案根目录下 -->
			<PluginsSourceRoot>$(SolutionDir)</PluginsSourceRoot>

			<!-- 确定输出目录 -->
			<BaseOutputDir Condition="'$(PublishDir)'==''">$([System.IO.Path]::GetFullPath('$(OutputPath)'))</BaseOutputDir>
			<BaseOutputDir Condition="'$(PublishDir)'!=''">$([System.IO.Path]::GetFullPath('$(PublishDir)'))</BaseOutputDir>

			<!-- 【核心修改2】修复路径拼接，确保带斜杠 -->
			<TargetPluginsDir>$([System.IO.Path]::Combine($(BaseOutputDir), 'Plugins'))</TargetPluginsDir>
			<CurrentPhase Condition="'$(PublishDir)'==''">Build</CurrentPhase>
			<CurrentPhase Condition="'$(PublishDir)'!=''">Publish</CurrentPhase>
		</PropertyGroup>

		<!-- 2. 创建目录 -->
		<MakeDir Directories="$(TargetPluginsDir)" />

		<!-- 3. 【核心修改3】扫描路径适配你的实际结构：直接扫描解决方案根目录下的所有插件项目 -->
		<ItemGroup>
			<CandidatePluginDlls Include="$(PluginsSourceRoot)\*\bin\$(Configuration)\net10.0\*.dll" />
			<CandidatePluginDlls Include="$(PluginsSourceRoot)\*\bin\$(Configuration)\net10.0\*.pdb" Condition="'$(Configuration)'=='Debug'" />
		</ItemGroup>

		<!-- 4. 去重与过滤 -->
		<RemoveDuplicates Inputs="@(CandidatePluginDlls)">
			<Output TaskParameter="Filtered" ItemName="UniqueCandidateDlls" />
		</RemoveDuplicates>

		<ItemGroup>
			<ValidPluginDlls Include="@(UniqueCandidateDlls)" Condition="Exists('%(Identity)') And &#xD;&#xA;                          !$([System.String]::Copy('%(Filename)').StartsWith('CrawlerCore')) And &#xD;&#xA;                          !$([System.String]::Copy('%(Filename)').StartsWith('CrawlerWorker')) And &#xD;&#xA;                          !$([System.String]::Copy('%(Filename)').StartsWith('CrawlerMaster')) And &#xD;&#xA;                          !$([System.String]::Copy('%(Filename)').StartsWith('Google.')) And &#xD;&#xA;                          !$([System.String]::Copy('%(Filename)').StartsWith('Grpc.')) And &#xD;&#xA;                          !$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.')) And &#xD;&#xA;                          !$([System.String]::Copy('%(Filename)').StartsWith('Serilog')) And &#xD;&#xA;                          !$([System.String]::Copy('%(Filename)').StartsWith('System.')) And &#xD;&#xA;                          !$([System.String]::Copy('%(Filename)').StartsWith('AngleSharp')) And &#xD;&#xA;                          !$([System.String]::Copy('%(Filename)').StartsWith('HtmlAgilityPack'))" />
		</ItemGroup>

		<!-- 5. 执行复制 -->
		<Copy SourceFiles="@(ValidPluginDlls)" DestinationFolder="$(TargetPluginsDir)" SkipUnchangedFiles="True" OverwriteReadOnlyFiles="True" />

		<!-- 6. 日志输出 (增加了源路径打印以便调试) -->
		<Message Text="========================================" Importance="high" />
		<Message Text="   插件 DLL 复制处理完成" Importance="high" />
		<Message Text="   阶段: $(CurrentPhase)" Importance="high" />
		<Message Text="   扫描源: $(PluginsSourceRoot)" Importance="high" />
		<Message Text="   目标目录: $(TargetPluginsDir)" Importance="high" />
		<Message Text="   扫描到候选: @(UniqueCandidateDlls-&gt;Count()) 个" Importance="high" />
		<Message Text="   有效插件数: @(ValidPluginDlls-&gt;Count()) 个" Importance="high" />
		<Message Text="   复制列表: @(ValidPluginDlls->'%(Filename)%(Extension)')" Importance="high" Condition="'@(ValidPluginDlls)'!=''" />
		<Message Text="========================================" Importance="high" />
	</Target>

</Project>
