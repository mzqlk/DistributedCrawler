{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Grpc": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Grpc": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "GrpcSettings": {
    "MasterEndpoint": "http://localhost:5001",
    "WorkerEndpoint": "http://0.0.0.0:5002",
    "NodeAuthToken": "",
    "MaxRetryAttempts": 3,
    "RetryDelayMilliseconds": 1000,
    "MaxRetryDelaySeconds": 30,
    "MasterResponseTimeoutSeconds": 10,
    "ResultAckTimeoutSeconds": 60,
    "HeartbeatIntervalSeconds": 5,
    "KeepAlivePingDelaySeconds": 15,
    "KeepAlivePingTimeoutSeconds": 30,
    "ConnectionIdleTimeoutMinutes": 30,
    "MaxMessageSizeMb": 64
  },
  "CrawlerSettings": {
    "DefaultUserAgent": "DistributedCrawler/1.0 (+https://github.com/mzqlk/DistributedCrawler)",
    "RequestTimeoutSeconds": 30,
    "MaxConcurrentRequests": 10,
    "DelayBetweenRequestsMs": 1000,
    "EnableProgressSimulation": false,
    "MaxConcurrentTasks": 2,
    "RobotsCacheHours": 24,
    "MaxRequestRetries": 2,
    "MaxResponseBytes": 5242880,
    "SameHostOnly": true,
    "PluginTimeoutSeconds": 30,
    "PluginDirectory": "Plugins",
    "IgnoreCertificateErrors": false
  }
}
