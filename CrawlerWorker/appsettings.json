{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Debug",
      "Grpc": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Debug",
        "Grpc": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "GrpcSettings": {
    "MasterEndpoint": "http://host.docker.internal:5001",
    "WorkerEndpoint": "http://0.0.0.0:5002",
    "MaxRetryAttempts": 3,
    "RetryDelayMilliseconds": 1000,
    "HeartbeatIntervalSeconds": 5,
    "ConnectionIdleTimeoutMinutes": 30,
    "MaxMessageSizeMb": 64,
    "NodeAuthToken": "test-token"
  },
  "CrawlerSettings": {
    "DefaultUserAgent": "Mozilla/5.0 (compatible; DistributedCrawler/1.0)",
    "RequestTimeoutSeconds": 30,
    "MaxConcurrentRequests": 10,
    "DelayBetweenRequestsMs": 1000,
    "EnableProgressSimulation": true
  }
}