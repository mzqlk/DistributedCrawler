{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "Grpc": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information"
    }
  },
  "GrpcSettings": {
    "MasterEndpoint": "http://0.0.0.0:5001",
    "WorkerEndpoint": "http://0.0.0.0:5002",
    "MaxRetryAttempts": 3,
    "RetryDelayMilliseconds": 1000,
    "HeartbeatIntervalSeconds": 5,
    "ConnectionIdleTimeoutMinutes": 30,
    "MaxMessageSizeMb": 64,
    "NodeAuthToken": "",
    "KeepAlivePingDelaySeconds": 15,
    "KeepAlivePingTimeoutSeconds": 30
  },
  "ConnectionStrings": {
    "ConnectionString": "Data Source=crawler.db"
  },
  "CrawlerSettings": {
    "DefaultUserAgent": "Mozilla/5.0 (compatible; DistributedCrawler/1.0)",
    "RequestTimeoutSeconds": 30,
    "MaxConcurrentRequests": 10,
    "DelayBetweenRequestsMs": 1000,
    "EnableProgressSimulation": true
  },
  "SignalRSettings": {
    "Port": 5003,
    "ListenAddress": "127.0.0.1",
    "AllowedOrigins": [],
    "HubPath": "/crawlerHub",
    "NodeUpdateThrottleSeconds": 5,
    "TaskProgressThrottleSeconds": 2
  },
  "HealthCheckSettings": {
    "CheckIntervalSeconds": 15,
    "NodeTimeoutSeconds": 60
  },
  "LoadBalancingSettings": {
    "MaxCpuPercent": 90,
    "MaxMemoryPercent": 90
  }
}