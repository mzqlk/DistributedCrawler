<Window x:Class="CrawlerMaster.WPF.Views.NodeDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:CrawlerMaster.WPF.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:CrawlerMaster.WPF.Converters"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d" 
        Title="节点详情" 
        Height="1500" Width="1500"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        d:DataContext="{d:DesignInstance Type=vm:NodeDetailViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <ResourceDictionary>
            <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:UtcToLocalTimeConverter x:Key="UtcToLocalConverter" />
            <converters:NullToDashConverter x:Key="NullToDashConverter" />
            <converters:RelativeTimeConverter x:Key="RelativeTimeConverter" />
            <converters:GreaterThanConverter x:Key="GreaterThanConverter" />

            <Style x:Key="DetailCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="8" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#424242" />
                <Setter Property="Margin" Value="0 0 12 8" />
            </Style>

            <Style x:Key="LabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#757575" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ValueTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="#212121" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>

            <Style x:Key="CpuWarningValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueTextStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TargetNode.CpuUsage, Converter={StaticResource GreaterThanConverter}, ConverterParameter=80}" Value="True">
                        <Setter Property="Foreground" Value="#F57C00" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MemoryWarningValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueTextStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TargetNode.MemoryUsageMb, Converter={StaticResource GreaterThanConverter}, ConverterParameter=90}" Value="True">
                        <Setter Property="Foreground" Value="#F57C00" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="RequestClose" SourceObject="{Binding}">
            <i:CallMethodAction MethodName="Close" TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 窗口头部 -->
        <Border Grid.Row="0" Style="{StaticResource DetailCardStyle}" Margin="8 0 8 16"
                Visibility="{Binding HasValidNode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="节点详情" FontSize="18" FontWeight="Bold" Foreground="#212121" />
                    <TextBlock Text="{Binding TargetNode.NodeId, TargetNullValue=--, FallbackValue=--}" 
                               FontSize="12" Foreground="#9E9E9E" Margin="0 4 0 0" />
                </StackPanel>

                <Border Grid.Column="1" CornerRadius="4" Padding="12 4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFEBEE" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNodeOnline, FallbackValue=False}" Value="True">
                                    <Setter Property="Background" Value="#E8F5E9" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding TargetNode.Status, TargetNullValue=--, FallbackValue=--}"
                               FontWeight="SemiBold" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#C62828" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNodeOnline, FallbackValue=False}" Value="True">
                                        <Setter Property="Foreground" Value="#2E7D32" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- 详情内容区域 -->
        <Grid Grid.Row="1" Visibility="{Binding HasValidNode, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 基础信息卡片 -->
            <Border Grid.Row="0" Style="{StaticResource DetailCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0 0 16 0">
                            <TextBlock Text="硬件配置" Style="{StaticResource SectionTitleStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="机器名：" Style="{StaticResource LabelTextStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TargetNode.MachineName, TargetNullValue=--}" Style="{StaticResource ValueTextStyle}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="IP地址：" Style="{StaticResource LabelTextStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TargetNode.IpAddress, TargetNullValue=--}" Style="{StaticResource ValueTextStyle}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="CPU核心数：" Style="{StaticResource LabelTextStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TargetNode.CpuCores, TargetNullValue=--}" Style="{StaticResource ValueTextStyle}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="总内存(GB)：" Style="{StaticResource LabelTextStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TargetNode.TotalMemoryGb, StringFormat={}{0:F2}, TargetNullValue=--}" Style="{StaticResource ValueTextStyle}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="16 0 0 0">
                            <TextBlock Text="实时运行数据" Style="{StaticResource SectionTitleStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU使用率：" Style="{StaticResource LabelTextStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TargetNode.CpuUsage, StringFormat={}{0:F2}%, TargetNullValue=--}" Style="{StaticResource CpuWarningValueStyle}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="内存占用(MB)：" Style="{StaticResource LabelTextStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TargetNode.MemoryUsageMb, StringFormat={}{0:F2}, TargetNullValue=--}" Style="{StaticResource MemoryWarningValueStyle}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="磁盘使用率：" Style="{StaticResource LabelTextStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TargetNode.DiskUsagePercent, StringFormat={}{0:F2}%, TargetNullValue=--}" Style="{StaticResource ValueTextStyle}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="活跃任务数：" Style="{StaticResource LabelTextStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TargetNode.ActiveTasks, TargetNullValue=--}" Style="{StaticResource ValueTextStyle}" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0 12 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="最后心跳：" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding TargetNode.LastHeartbeat, Converter={StaticResource RelativeTimeConverter}, TargetNullValue=--}" 
                                   Style="{StaticResource ValueTextStyle}" Margin="0 0 16 0" />
                        <TextBlock Grid.Column="2" Text="{Binding TargetNode.LastHeartbeat, Converter={StaticResource UtcToLocalConverter}, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}, TargetNullValue=--}" 
                                   Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 资源趋势图表区域（最终修复版：极简逻辑，直接绑定） -->
            <Border Grid.Row="1" Style="{StaticResource DetailCardStyle}" Margin="8 16 8 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="资源使用率趋势" Style="{StaticResource SectionTitleStyle}" />

                    <!-- CPU图表：直接绑定，不做多余的Visibility判断 -->
                    <Border Grid.Row="1" Grid.Column="0" Margin="8">
                        <oxy:PlotView Model="{Binding CpuPlotModel}" Height="280" />
                    </Border>

                    <!-- 内存图表：直接绑定，不做多余的Visibility判断 -->
                    <Border Grid.Row="1" Grid.Column="1" Margin="8">
                        <oxy:PlotView Model="{Binding MemoryPlotModel}" Height="280" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2" Style="{StaticResource DetailCardStyle}" Margin="8 16 8 0">
            <Grid HorizontalAlignment="Right">
                <Button Content="关闭窗口" 
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="24 8"
                        FontSize="12" />
            </Grid>
        </Border>

        <!-- 无数据占位符 -->
        <Border Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource DetailCardStyle}" Margin="8"
        Visibility="{Binding ShowNoDataPlaceholder, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="48" Height="48" Foreground="#9E9E9E"/>
                <TextBlock Text="节点数据无效" Margin="0 16 0 0" FontSize="16" Foreground="#757575" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>