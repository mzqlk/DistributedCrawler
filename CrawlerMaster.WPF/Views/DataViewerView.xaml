<UserControl x:Class="CrawlerMaster.WPF.Views.DataViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:CrawlerMaster.WPF.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:CrawlerMaster.WPF.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=vm:DataViewerViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:UtcToLocalTimeConverter x:Key="UtcToLocalTimeConverter"/>
            <converters:NullToDashConverter x:Key="NullToDashConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisConverter"/>

            <Style x:Key="CenteredTextStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="UrlTextStyle" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="300"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*" MinHeight="300"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. 搜索筛选栏（新增导出按钮） -->
        <DockPanel Grid.Row="0" Margin="0 0 0 12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <materialDesign:Card Padding="0" Margin="0 0 8 0">
                    <Grid Width="300">
                        <TextBox x:Name="SearchTextBox" 
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="输入任务ID/任务名称搜索"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0 12 0 0"/>
                    </Grid>
                </materialDesign:Card>
                <Button Content="搜索" Command="{Binding SearchCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" Margin="0 0 8 0"/>
                <Button Content="刷新列表" Command="{Binding LoadCrawlResultsCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0 0 8 0"/>
                <!-- 新增导出按钮 -->
                <Button Content="导出" Command="{Binding ExportCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </StackPanel>
            <TextBlock Text="爬取结果数据管理" FontSize="18" FontWeight="SemiBold" 
                       Foreground="{DynamicResource MaterialDesignBody}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 2. 主列表空数据占位符 -->
        <Border Grid.Row="1" Grid.RowSpan="2"
                Background="#FAFAFA" CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CrawlResults.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="DatabaseOff" Width="64" Height="64" Foreground="#9E9E9E"/>
                <TextBlock Text="暂无爬取结果" Margin="0 16 0 0" FontSize="16" Foreground="#757575" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 3. 主列表：CrawlResult 爬取总结果 -->
        <DataGrid Grid.Row="1"
                  x:Name="CrawlResultDataGrid"
                  ItemsSource="{Binding CrawlResults}"
                  SelectedItem="{Binding SelectedCrawlResult, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  MaxWidth="1920"
                  Margin="0 0 0 16"
                  materialDesign:DataGridAssist.CellPadding="8 4"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="20,4,0,4"
                  ColumnHeaderHeight="36">

            <DataGrid.Style>
                <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
                    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                    <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Opacity" Value="0.5"/>
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>

            <DataGrid.Columns>
                <DataGridTextColumn Header="任务ID" Binding="{Binding TaskId}" Width="280"/>
                <DataGridTextColumn Header="任务名称" Binding="{Binding TaskName}" Width="200"/>
                <DataGridTextColumn Header="总爬取页数" Binding="{Binding TotalPages}" Width="120" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="完成时间" 
                                    Binding="{Binding CompletedAt, Converter={StaticResource UtcToLocalTimeConverter}, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" 
                                    Width="180"/>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Height="4" Background="#E0E0E0"/>

        <!-- 4. 子列表：PageResult 单页爬取结果（新增选中项绑定+双击事件） -->
        <DataGrid Grid.Row="3"
                  x:Name="PageResultDataGrid"
                  ItemsSource="{Binding CurrentPageResults}"
                  SelectedItem="{Binding SelectedPageResult, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  MaxWidth="1920"
                  materialDesign:DataGridAssist.CellPadding="8 4"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="20,4,0,4"
                  ColumnHeaderHeight="36"
                  Visibility="{Binding SelectedCrawlResult, Converter={StaticResource NullToVisConverter}}">

            <!-- 新增双击事件绑定 -->
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <i:InvokeCommandAction Command="{Binding ShowPageDataDetailCommand}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <DataGrid.Style>
                <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
                    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                    <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentPageResults.Count}" Value="0">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <VisualBrush Stretch="None">
                                        <VisualBrush.Visual>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="48" Height="48" Foreground="#BDBDBD"/>
                                                <TextBlock Text="选中上方爬取结果，查看对应单页详情" 
                                                           Foreground="#9E9E9E" FontSize="14"
                                                           Margin="0 12 0 0"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>

            <DataGrid.Columns>
                <DataGridTextColumn Header="页面ID" Binding="{Binding Id}" Width="80" ElementStyle="{StaticResource CenteredTextStyle}"/>

                <DataGridTemplateColumn Header="目标URL" Width="300">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Url}" Style="{StaticResource UrlTextStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="最终URL" Width="300">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FinalUrl}" Style="{StaticResource UrlTextStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="状态码" Binding="{Binding StatusCode}" Width="90" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="状态描述" Binding="{Binding StatusDescription}" Width="110" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="提取链接数" Binding="{Binding LinkCount}" Width="100" ElementStyle="{StaticResource CenteredTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 5. 分页栏 -->
        <DockPanel Grid.Row="4" Margin="0 12 0 0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="总条数：" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
                <TextBlock Text="{Binding TotalCount}" VerticalAlignment="Center" Margin="0 0 24 0" 
                           FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                <TextBlock Text="当前页：" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
                <TextBlock Text="{Binding DisplayPageIndex}" VerticalAlignment="Center" Margin="0 0 24 0"
                           FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                <Button Content="上一页" Command="{Binding PrevPageCommand}" 
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0 0 8 0"/>
                <Button Content="下一页" Command="{Binding NextPageCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </StackPanel>
        </DockPanel>

        <!-- 全局加载遮罩 -->
        <Border Grid.RowSpan="5" Background="#80FFFFFF" 
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                             IsIndeterminate="{Binding IsLoading}" 
                             Width="48" Height="48"/>
                <TextBlock Text="数据加载中..." FontSize="16" FontWeight="SemiBold" 
                           Foreground="{DynamicResource MaterialDesignBody}"
                           Margin="0 16 0 0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>